#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

# Recreate the venv when its interpreter is missing or broken, it has no pip
# (e.g. left over from an interrupted "python3 -m venv"), or it's a different
# Python version than the image (e.g. after changing the devcontainer image).
want="$(python3 -c 'import sys; print(sys.version_info[:2])')"
have="$(.venv/bin/python3 -c 'import sys, pip; print(sys.version_info[:2])' 2>/dev/null || true)"
if [[ "${have}" != "${want}" ]]; then
  python3 -m venv --clear .venv
fi

.venv/bin/python -m pip install --upgrade pip
.venv/bin/python -m pip install --requirement requirements.txt
.venv/bin/python -m pip install --requirement requirements-test.txt
